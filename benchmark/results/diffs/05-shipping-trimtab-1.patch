+test('chargeable weight is the larger of actual and volumetric, rounded up to 0.5 kg', () => {
+  // Volumetric 40 * 30 * 20 / 5000 = 4.8 kg.
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 40, widthCm: 30, heightCm: 20 }), 5);
