+  // Exact multiples of 0.5 stay as they are: volumetric 50 * 50 * 20 / 5000 = 10 kg.
+  assert.equal(chargeableWeightKg({ weightKg: 2, lengthCm: 50, widthCm: 50, heightCm: 20 }), 10);
+  assert.equal(chargeableWeightKg({ weightKg: 2.5 }), 2.5);
