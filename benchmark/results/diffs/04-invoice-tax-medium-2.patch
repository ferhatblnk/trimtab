@@ -0,0 +1,102 @@
+// All arithmetic is done in BigInt so floating-point error can never change a cent.
+
+const BASIS_POINTS = 10000n;
+
+// Converts a percentage with at most two decimals (e.g. 8.25) into basis points (825n)
+// by parsing its decimal text, never by multiplying a float.
+export function percentToBasisPoints(percent, name = 'percent') {
+  const match = typeof percent === 'number' && Number.isFinite(percent)
+    ? /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(percent))
+    : null;
+  if (!match || percent > 100) {
+    throw new Error(`Invalid ${name}: ${percent}`);
+  }
+  const [, whole, fraction = ''] = match;
+  return BigInt(whole) * 100n + BigInt(fraction.padEnd(2, '0'));
+}
+
+// Rounds numerator / denominator (denominator > 0) to the nearest integer, ties to even.
+// Symmetric for negative values: -13.5 becomes -14.
+export function divideRoundHalfEven(numerator, denominator) {
+  const negative = numerator < 0n;
+  const abs = negative ? -numerator : numerator;
+  let quotient = abs / denominator;
+  const twiceRemainder = (abs % denominator) * 2n;
+  if (twiceRemainder > denominator || (twiceRemainder === denominator && quotient % 2n === 1n)) {
+    quotient += 1n;
+  }
+  return negative ? -quotient : quotient;
+}
+
+// Splits total across weights (all > 0) in proportion, with the largest-remainder method.
+// Ties go to the earlier index.
+export function allocateLargestRemainder(total, weights) {
+  const weightSum = weights.reduce((sum, weight) => sum + weight, 0n);
+  if (weightSum === 0n) {
+    return weights.map(() => 0n);
+  }
+  const shares = weights.map((weight, index) => ({
+    index,
+    amount: (total * weight) / weightSum,
+    remainder: (total * weight) % weightSum,
+  }));
+  let leftover = total - shares.reduce((sum, share) => sum + share.amount, 0n);
+  const byRemainder = [...shares].sort((a, b) =>
+    a.remainder === b.remainder ? a.index - b.index : a.remainder > b.remainder ? -1 : 1,
+  );
+  for (const share of byRemainder) {
+    if (leftover === 0n) {
+      break;
+    }
+    share.amount += 1n;
+    leftover -= 1n;
+  }
+  return shares.map((share) => share.amount);
+}
+
+function toSafeNumber(value) {
+  const number = Number(value);
+  if (!Number.isSafeInteger(number)) {
+    throw new Error(`Amount out of range: ${value}`);
+  }
+  return number;
+}
+
+export function computeInvoice(lines, { taxRatePercent, discountPercent = 0 } = {}) {
+  const taxBp = percentToBasisPoints(taxRatePercent, 'taxRatePercent');
+  const discountBp = percentToBasisPoints(discountPercent, 'discountPercent');
+
+  const nets = lines.map(({ quantity, unitCents }) => {
+    if (!Number.isSafeInteger(quantity) || !Number.isSafeInteger(unitCents)) {
+      throw new Error(`Invalid line: quantity ${quantity}, unitCents ${unitCents}`);
+    }
+    return BigInt(quantity) * BigInt(unitCents);
+  });
+
+  const positiveNets = nets.filter((net) => net > 0n);
+  const positiveSum = positiveNets.reduce((sum, net) => sum + net, 0n);
+  const invoiceDiscount = divideRoundHalfEven(positiveSum * discountBp, BASIS_POINTS);
+  const positiveDiscounts = allocateLargestRemainder(invoiceDiscount, positiveNets);
+
+  let nextPositive = 0;
+  const bigLines = nets.map((net) => {
+    const discount = net > 0n ? positiveDiscounts[nextPositive++] : 0n;
+    const taxable = net - discount;
+    const tax = divideRoundHalfEven(taxable * taxBp, BASIS_POINTS);
+    return { net, discount, tax, gross: taxable + tax };
+  });
+
+  const sum = (key) => bigLines.reduce((total, line) => total + line[key], 0n);
+  return {
+    lines: bigLines.map((line) => ({
+      netCents: toSafeNumber(line.net),
+      discountCents: toSafeNumber(line.discount),
+      taxCents: toSafeNumber(line.tax),
+      grossCents: toSafeNumber(line.gross),
+    })),
+    netCents: toSafeNumber(sum('net')),
+    discountCents: toSafeNumber(sum('discount')),
+    taxCents: toSafeNumber(sum('tax')),
+    grossCents: toSafeNumber(sum('gross')),
+  };
+}
