@@ -0,0 +1,91 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { computeInvoice } from '../src/tax.js';
+
+test('computes net, tax and gross per line and in total', () => {
+  const invoice = computeInvoice([{ quantity: 2, unitCents: 1250 }, { quantity: 1, unitCents: 99 }], { taxRatePercent: 20 });
+  assert.deepEqual(invoice, {
+    lines: [
+      { netCents: 2500, discountCents: 0, taxCents: 500, grossCents: 3000 },
+      { netCents: 99, discountCents: 0, taxCents: 20, grossCents: 119 },
+    ],
+    netCents: 2599,
+    discountCents: 0,
+    taxCents: 520,
+    grossCents: 3119,
+  });
+});
+
+test('rounds tax half to even, symmetrically for credits', () => {
+  const taxes = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1350 },
+      { quantity: 1, unitCents: 1250 },
+      { quantity: -1, unitCents: 1350 },
+      { quantity: -1, unitCents: 1250 },
+    ],
+    { taxRatePercent: 1 },
+  ).lines.map((line) => line.taxCents);
+  assert.deepEqual(taxes, [14, 12, -14, -12]);
+});
+
+test('rounds the invoice discount half to even', () => {
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 250 }], { taxRatePercent: 0, discountPercent: 1 }).discountCents, 2);
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 350 }], { taxRatePercent: 0, discountPercent: 1 }).discountCents, 4);
+});
+
+test('splits the discount by largest remainder', () => {
+  const invoice = computeInvoice(
+    [{ quantity: 3, unitCents: 100 }, { quantity: 1, unitCents: 100 }, { quantity: 6, unitCents: 100 }],
+    { taxRatePercent: 0, discountPercent: 0.7 },
+  );
+  assert.deepEqual(invoice.lines.map((line) => line.discountCents), [2, 1, 4]);
+  assert.equal(invoice.discountCents, 7);
+});
+
+test('breaks remainder ties towards earlier lines and skips credit lines', () => {
+  const invoice = computeInvoice(
+    [
+      { quantity: 1, unitCents: 100 },
+      { quantity: -1, unitCents: 500 },
+      { quantity: 1, unitCents: 100 },
+      { quantity: 1, unitCents: 100 },
+    ],
+    { taxRatePercent: 0, discountPercent: 0.5 },
+  );
+  assert.deepEqual(invoice.lines.map((line) => line.discountCents), [1, 0, 1, 0]);
+  assert.deepEqual(invoice.lines.map((line) => line.grossCents), [99, -500, 99, 100]);
+  assert.equal(invoice.netCents, -200);
+  assert.equal(invoice.discountCents, 2);
+});
+
+test('taxes the discounted net', () => {
+  const invoice = computeInvoice([{ quantity: 1, unitCents: 10000 }], { taxRatePercent: 8.25, discountPercent: 12.5 });
+  assert.deepEqual(invoice.lines[0], { netCents: 10000, discountCents: 1250, taxCents: 722, grossCents: 9472 });
+});
+
+test('is not affected by floating-point error', () => {
+  // 1000 * 1.15 / 100 is 11.499999999999998 in floating point; the exact 11.5 rounds to 12.
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 1000 }], { taxRatePercent: 1.15 }).taxCents, 12);
+  // Exact beyond 2^53 in intermediate products.
+  const big = computeInvoice([{ quantity: 1, unitCents: 9_000_000_000_000 }], { taxRatePercent: 99.99, discountPercent: 33.33 });
+  assert.equal(big.discountCents, 2_999_700_000_000);
+  assert.equal(big.taxCents, 5_999_699_970_000);
+});
+
+test('handles empty invoices', () => {
+  assert.deepEqual(computeInvoice([], { taxRatePercent: 20, discountPercent: 10 }), {
+    lines: [],
+    netCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    grossCents: 0,
+  });
+});
+
+test('rejects invalid percentages and lines', () => {
+  assert.throws(() => computeInvoice([], { taxRatePercent: 8.255 }), /Invalid taxRatePercent/);
+  assert.throws(() => computeInvoice([], { taxRatePercent: 101 }), /Invalid taxRatePercent/);
+  assert.throws(() => computeInvoice([], { taxRatePercent: 20, discountPercent: -1 }), /Invalid discountPercent/);
+  assert.throws(() => computeInvoice([{ quantity: 1.5, unitCents: 100 }], { taxRatePercent: 20 }), /Invalid line/);
+});
