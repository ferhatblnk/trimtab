+
+test('defaults currency to USD and accepts ISO codes', () => {
+  assert.equal(createCustomer({ id: 'c1', name: 'A', email: 'a@b.test', country: 'TR' }).currency, 'USD');
+  assert.equal(createCustomer({ id: 'c1', name: 'A', email: 'a@b.test', country: 'TR', currency: 'EUR' }).currency, 'EUR');
+});
+
+test('rejects invalid currencies', () => {
+  for (const currency of ['eur', 'EU', 'EURO', '', null, 978]) {
+    assert.throws(
+      () => createCustomer({ id: 'c1', name: 'A', email: 'a@b.test', country: 'TR', currency }),
+      { message: `Invalid currency: ${currency}` },
+    );
+  }
+});
