+
+test('charges the volumetric weight when it is larger than the actual weight', () => {
+  // Volumetric: 40 × 30 × 20 / 5000 = 4.8 kg.
+  assert.equal(chargeableWeightKg({ weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 }), 5);
+});
+
+test('keeps a chargeable weight that is already a multiple of 0.5 kg', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 2 }), 2);
+  assert.equal(chargeableWeightKg({ weightKg: 1.5, lengthCm: 10, widthCm: 10, heightCm: 10 }), 1.5);
+  // Volumetric: 50 × 50 × 5 / 5000 = 2.5 kg.
+  assert.equal(chargeableWeightKg({ weightKg: 1, lengthCm: 50, widthCm: 50, heightCm: 5 }), 2.5);
+  // 2.2 × 100 × 125 / 5000 is exactly 5.5 kg, but computes as 5.500000000000001 in floating point.
+  assert.equal(chargeableWeightKg({ weightKg: 1, lengthCm: 2.2, widthCm: 100, heightCm: 125 }), 5.5);
+});
+
+test('rounds up to the next 0.5 kg', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 0.1 }), 0.5);
+  assert.equal(chargeableWeightKg({ weightKg: 2.01 }), 2.5);
+  assert.equal(chargeableWeightKg({ weightKg: 2.51 }), 3);
+});
+
+test('uses the actual weight when a dimension is missing', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 100, widthCm: 100 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 100, widthCm: 100, heightCm: null }), 1.5);
+});
+
+test('prices a shipment by its chargeable weight', () => {
+  // Actual 0.8 kg would be in the 1 kg band; volumetric 4.8 kg rounds up to 5 kg.
+  const shipment = { weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 };
+  assert.equal(shippingRate(shipment, ZONES.DOMESTIC), 900);
+  assert.equal(shippingRate(shipment, ZONES.EUROPE), 2400);
