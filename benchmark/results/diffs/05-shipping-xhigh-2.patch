-export function shippingRate(weightKg, zone) {
+const VOLUMETRIC_DIVISOR = 5000;
+
+// Absorbs float error so e.g. 2.2 × 100 × 125 cm (exactly 5.5 kg) is not rounded up to 6.
+const ROUNDING_TOLERANCE = 1e-9;
+
+function roundUpToHalfKg(kg) {
+  return Math.ceil(kg * 2 - ROUNDING_TOLERANCE) / 2;
+}
+
+/**
+ * Weight a shipment is billed by: the larger of its actual weight and its volumetric weight
+ * (lengthCm × widthCm × heightCm / 5000), rounded up to the next 0.5 kg.
+ * When any dimension is missing, the actual weight is used.
+ */
+export function chargeableWeightKg({ weightKg, lengthCm, widthCm, heightCm }) {
+  if (!(weightKg > 0)) {
+    throw new Error(`Invalid weight: ${weightKg}`);
+  }
+  if (lengthCm == null || widthCm == null || heightCm == null) {
+    return roundUpToHalfKg(weightKg);
+  }
+  const volumetricKg = (lengthCm * widthCm * heightCm) / VOLUMETRIC_DIVISOR;
+  return roundUpToHalfKg(Math.max(weightKg, volumetricKg));
+}
+
+/**
+ * Rate in cents for a weight in kg, or for a shipment priced by its chargeable weight.
+ */
+export function shippingRate(weightOrShipment, zone) {
   const table = RATES[zone];
   if (!table) {
     throw new Error(`Unknown zone: ${zone}`);
   }
+  const weightKg =
+    typeof weightOrShipment === 'object' && weightOrShipment !== null
+      ? chargeableWeightKg(weightOrShipment)
+      : weightOrShipment;
   if (!(weightKg > 0)) {
     throw new Error(`Invalid weight: ${weightKg}`);
   }
