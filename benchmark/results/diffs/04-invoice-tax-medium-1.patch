+++ b/test/tax.test.js
@@ -0,0 +1,97 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { computeInvoice, divRoundHalfEven } from '../src/tax.js';
+
+test('rounds half to even, symmetric for negatives', () => {
+  assert.equal(divRoundHalfEven(135n, 10n), 14n);
+  assert.equal(divRoundHalfEven(125n, 10n), 12n);
+  assert.equal(divRoundHalfEven(-135n, 10n), -14n);
+  assert.equal(divRoundHalfEven(-125n, 10n), -12n);
+  assert.equal(divRoundHalfEven(-126n, 10n), -13n);
+});
+
+test('computes a simple invoice without discount', () => {
+  const result = computeInvoice([{ quantity: 2, unitCents: 1000 }], { taxRatePercent: 20 });
+  assert.deepEqual(result, {
+    lines: [{ netCents: 2000, discountCents: 0, taxCents: 400, grossCents: 2400 }],
+    netCents: 2000,
+    discountCents: 0,
+    taxCents: 400,
+    grossCents: 2400,
+  });
+});
+
+test('splits the discount with largest remainder, ties to the earlier line', () => {
+  // 10% of 10 = 1 cent to hand out.
+  const result = computeInvoice(
+    [
+      { quantity: 1, unitCents: 3 },
+      { quantity: 1, unitCents: 3 },
+      { quantity: 1, unitCents: 4 },
+    ],
+    { taxRatePercent: 0, discountPercent: 10 },
+  );
+  // exact shares: 0.3, 0.3, 0.4 -> third line has the largest remainder.
+  assert.deepEqual(result.lines.map((line) => line.discountCents), [0, 0, 1]);
+
+  const tied = computeInvoice(
+    [
+      { quantity: 1, unitCents: 5 },
+      { quantity: 1, unitCents: 5 },
+    ],
+    { taxRatePercent: 0, discountPercent: 10 },
+  );
+  // 10% of 10 = 1; shares 0.5 and 0.5 -> earlier line wins.
+  assert.deepEqual(tied.lines.map((line) => line.discountCents), [1, 0]);
+});
+
+test('rounds the invoice discount half to even', () => {
+  // 12.5% of 100 = 12.5 -> 12; 12.5% of 300 = 37.5 -> 38.
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 100 }], { taxRatePercent: 0, discountPercent: 12.5 }).discountCents, 12);
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 300 }], { taxRatePercent: 0, discountPercent: 12.5 }).discountCents, 38);
+});
+
+test('credit lines get no discount and round tax symmetrically', () => {
+  const result = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1000 },
+      { quantity: -1, unitCents: 150 },
+    ],
+    { taxRatePercent: 9, discountPercent: 10 },
+  );
+  // Credit: 9% of -150 = -13.5 -> -14.
+  assert.deepEqual(result.lines[1], { netCents: -150, discountCents: 0, taxCents: -14, grossCents: -164 });
+  // Positive line: net 1000, discount 100, tax 9% of 900 = 81.
+  assert.deepEqual(result.lines[0], { netCents: 1000, discountCents: 100, taxCents: 81, grossCents: 981 });
+  assert.equal(result.netCents, 850);
+  assert.equal(result.discountCents, 100);
+  assert.equal(result.taxCents, 67);
+  assert.equal(result.grossCents, 817);
+});
+
+test('avoids floating-point error on fractional rates', () => {
+  // 8.25% of 200 = 16.5 exactly -> 16 (even). A float computation gives 16.500000000000004.
+  const result = computeInvoice([{ quantity: 1, unitCents: 200 }], { taxRatePercent: 8.25 });
+  assert.equal(result.taxCents, 16);
+  // 1.15% of 1000 = 11.5 -> 12. In float, 1.15 * 1000 / 100 = 11.499999999999998.
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 1000 }], { taxRatePercent: 1.15 }).taxCents, 12);
+});
+
+test('line discounts always add up to the invoice discount', () => {
+  const lines = [7, 13, 29, 31, 101].map((unitCents) => ({ quantity: 3, unitCents }));
+  const result = computeInvoice(lines, { taxRatePercent: 20, discountPercent: 33.33 });
+  const sum = result.lines.reduce((acc, line) => acc + line.discountCents, 0);
+  assert.equal(sum, result.discountCents);
+});
+
+test('handles an empty invoice and rejects bad rates', () => {
+  assert.deepEqual(computeInvoice([], { taxRatePercent: 20 }), {
+    lines: [],
+    netCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    grossCents: 0,
+  });
+  assert.throws(() => computeInvoice([], { taxRatePercent: 101 }), /Invalid taxRatePercent/);
+  assert.throws(() => computeInvoice([], { taxRatePercent: 8.125 }), /Invalid taxRatePercent/);
+});
