+// All arithmetic is done in BigInt so floating-point error can never change a cent.
+// Percentages are converted to exact hundredths of a percent (basis points).
+
+function toBasisPoints(percent, name) {
+  if (typeof percent !== 'number' || !(percent >= 0 && percent <= 100)) {
+    throw new Error(`Invalid ${name}: ${percent}`);
+  }
+  const bp = Math.round(percent * 100);
+  if (Math.abs(percent * 100 - bp) > 1e-6) {
+    throw new Error(`Invalid ${name}: ${percent} has more than two decimal places`);
+  }
+  return BigInt(bp);
+}
+
+// numerator / denominator rounded half to even, symmetric around zero. denominator > 0.
+export function divRoundHalfEven(numerator, denominator) {
+  const negative = numerator < 0n;
+  const abs = negative ? -numerator : numerator;
+  let quotient = abs / denominator;
+  const twiceRemainder = (abs % denominator) * 2n;
+  if (twiceRemainder > denominator || (twiceRemainder === denominator && quotient % 2n === 1n)) {
+    quotient += 1n;
+  }
+  return negative ? -quotient : quotient;
+}
+
+function toCentsNumber(value) {
+  const number = Number(value);
+  if (!Number.isSafeInteger(number)) {
+    throw new Error(`Amount out of range: ${value}`);
+  }
+  return number;
+}
+
+// Splits `total` across `weights` (non-negative BigInts) with the largest-remainder method.
+// Ties go to the earlier index.
+export function allocateLargestRemainder(total, weights) {
+  const sum = weights.reduce((acc, weight) => acc + weight, 0n);
+  if (sum === 0n) {
+    return weights.map(() => 0n);
+  }
+  const shares = weights.map((weight) => (total * weight) / sum);
+  const remainders = weights.map((weight, index) => ({ index, remainder: (total * weight) % sum }));
+  let leftover = total - shares.reduce((acc, share) => acc + share, 0n);
+  remainders.sort((a, b) => (a.remainder === b.remainder ? a.index - b.index : a.remainder > b.remainder ? -1 : 1));
+  for (let i = 0; leftover > 0n; i++, leftover--) {
+    shares[remainders[i].index] += 1n;
+  }
+  return shares;
+}
+
+export function computeInvoice(lines, { taxRatePercent, discountPercent = 0 }) {
+  const taxBp = toBasisPoints(taxRatePercent, 'taxRatePercent');
+  const discountBp = toBasisPoints(discountPercent, 'discountPercent');
+
+  const nets = lines.map(({ quantity, unitCents }) => {
+    if (!Number.isInteger(quantity) || !Number.isInteger(unitCents)) {
+      throw new Error(`Invalid line: quantity ${quantity}, unitCents ${unitCents}`);
+    }
+    return BigInt(quantity) * BigInt(unitCents);
+  });
+
+  const positiveNets = nets.map((net) => (net > 0n ? net : 0n));
+  const positiveTotal = positiveNets.reduce((acc, net) => acc + net, 0n);
+  const invoiceDiscount = divRoundHalfEven(positiveTotal * discountBp, 10000n);
+  const discounts = allocateLargestRemainder(invoiceDiscount, positiveNets);
+
+  const totals = { netCents: 0n, discountCents: 0n, taxCents: 0n, grossCents: 0n };
+  const resultLines = nets.map((net, index) => {
+    const discount = discounts[index];
+    const taxable = net - discount;
+    const tax = divRoundHalfEven(taxable * taxBp, 10000n);
+    const line = { netCents: net, discountCents: discount, taxCents: tax, grossCents: taxable + tax };
+    for (const key of Object.keys(totals)) {
+      totals[key] += line[key];
+    }
+    return line;
+  });
+
+  const toNumbers = (amounts) =>
+    Object.fromEntries(Object.entries(amounts).map(([key, value]) => [key, toCentsNumber(value)]));
+
+  return { lines: resultLines.map(toNumbers), ...toNumbers(totals) };
+}
diff --git a/test/tax.test.js b/test/tax.test.js
