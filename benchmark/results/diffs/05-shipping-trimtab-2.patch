@@ -12,3 +12,29 @@ test('rejects unknown zones and bad weights', () => {
   assert.throws(() => shippingRate(1, 'XX'), /Unknown zone/);
   assert.throws(() => shippingRate(0, ZONES.DOMESTIC), /Invalid weight/);
 });
+
+test('uses the EUR code for Europe', () => {
+  assert.equal(ZONES.EUROPE, 'EUR');
+  assert.equal(shippingRate(1, 'EUR'), 1200);
+  assert.throws(() => shippingRate(1, 'EU'), /Unknown zone/);
+});
+
+test('chargeable weight is the larger of actual and volumetric, rounded up to 0.5 kg', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 }), 5);
+  assert.equal(chargeableWeightKg({ weightKg: 7.2, lengthCm: 40, widthCm: 30, heightCm: 20 }), 7.5);
+  assert.equal(chargeableWeightKg({ weightKg: 1, lengthCm: 30, widthCm: 20, heightCm: 10 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 2.5, lengthCm: 10, widthCm: 10, heightCm: 10 }), 2.5);
+  assert.equal(chargeableWeightKg({ weightKg: 3, lengthCm: 10, widthCm: 10, heightCm: 10 }), 3);
+});
+
+test('chargeable weight falls back to actual weight when a dimension is missing', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 100, widthCm: 100 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 2 }), 2);
+});
+
+test('prices a shipment by its chargeable weight', () => {
+  const shipment = { weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 };
+  assert.equal(shippingRate(shipment, ZONES.DOMESTIC), 900);
+  assert.equal(shippingRate(0.8, ZONES.DOMESTIC), 500);
+  assert.throws(() => shippingRate({ weightKg: 0 }, ZONES.DOMESTIC), /Invalid weight/);
+});
