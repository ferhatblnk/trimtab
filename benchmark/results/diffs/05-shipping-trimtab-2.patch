-export function shippingRate(weightKg, zone) {
+export function chargeableWeightKg(shipment) {
+  const { weightKg, lengthCm, widthCm, heightCm } = shipment;
+  let weight = weightKg;
+  if (lengthCm != null && widthCm != null && heightCm != null) {
+    weight = Math.max(weight, (lengthCm * widthCm * heightCm) / 5000);
+  }
+  return Math.ceil(weight * 2) / 2;
+}
+
+export function shippingRate(weightOrShipment, zone) {
+  const weightKg =
+    typeof weightOrShipment === 'object' && weightOrShipment !== null
+      ? chargeableWeightKg(weightOrShipment)
+      : weightOrShipment;
   const table = RATES[zone];
   if (!table) {
