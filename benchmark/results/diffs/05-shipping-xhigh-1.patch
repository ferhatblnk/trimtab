+test('uses EUR as the Europe zone code', () => {
+  assert.equal(ZONES.EUROPE, 'EUR');
+  assert.equal(shippingRate(1, 'EUR'), 1200);
+  assert.throws(() => shippingRate(1, 'EU'), /Unknown zone/);
+});
+
 test('rejects unknown zones and bad weights', () => {
   assert.throws(() => shippingRate(1, 'XX'), /Unknown zone/);
   assert.throws(() => shippingRate(0, ZONES.DOMESTIC), /Invalid weight/);
+  assert.throws(() => shippingRate({ weightKg: 0 }, ZONES.DOMESTIC), /Invalid weight/);
+});
+
+test('chargeable weight is the larger of actual and volumetric weight', () => {
+  // 50 × 40 × 30 / 5000 = 12 kg volumetric
+  assert.equal(chargeableWeightKg({ weightKg: 2, lengthCm: 50, widthCm: 40, heightCm: 30 }), 12);
+  // 10 × 10 × 10 / 5000 = 0.2 kg volumetric
+  assert.equal(chargeableWeightKg({ weightKg: 3, lengthCm: 10, widthCm: 10, heightCm: 10 }), 3);
+});
+
+test('chargeable weight rounds up to the next 0.5 kg', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 1.01 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 1.6 }), 2);
+  assert.equal(chargeableWeightKg({ weightKg: 0.1 }), 0.5);
+  // 31 × 20 × 10 / 5000 = 1.24 kg volumetric
+  assert.equal(chargeableWeightKg({ weightKg: 1, lengthCm: 31, widthCm: 20, heightCm: 10 }), 1.5);
+});
+
+test('chargeable weight keeps exact multiples of 0.5 kg', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 1.5 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 4 }), 4);
+  // 25 × 10 × 10 / 5000 = 0.5 kg volumetric
+  assert.equal(chargeableWeightKg({ weightKg: 0.2, lengthCm: 25, widthCm: 10, heightCm: 10 }), 0.5);
+});
+
+test('chargeable weight falls back to actual weight when a dimension is missing', () => {
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 100, widthCm: 100 }), 1.5);
+  assert.equal(chargeableWeightKg({ weightKg: 2, lengthCm: 100, widthCm: 100, heightCm: null }), 2);
+});
+
+test('chargeable weight rejects bad weights', () => {
+  assert.throws(() => chargeableWeightKg({ lengthCm: 50, widthCm: 40, heightCm: 30 }), /Invalid weight/);
+  assert.throws(() => chargeableWeightKg({ weightKg: -1 }), /Invalid weight/);
+});
+
+test('prices a shipment by its chargeable weight', () => {
+  const bulky = { weightKg: 2, lengthCm: 50, widthCm: 40, heightCm: 30 };
+  assert.equal(shippingRate(bulky, ZONES.DOMESTIC), 1900);
+  assert.equal(shippingRate({ weightKg: 2 }, ZONES.DOMESTIC), 900);
+  assert.equal(shippingRate({ weightKg: 1.01 }, ZONES.EUROPE), 2400);
 });
