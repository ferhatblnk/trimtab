-export function shippingRate(weightKg, zone) {
+const VOLUMETRIC_DIVISOR = 5000;
+
+/**
+ * Billable weight of a shipment `{ weightKg, lengthCm, widthCm, heightCm }`: the larger of the
+ * actual and the volumetric weight (L × W × H / 5000), rounded up to the next 0.5 kg.
+ * When any dimension is missing, only the actual weight is used.
+ */
+export function chargeableWeightKg(shipment) {
+  const { weightKg, lengthCm, widthCm, heightCm } = shipment;
+  // Work in half-kilogram units so exact multiples of 0.5 are not bumped up by float error.
+  let halfKg = weightKg * 2;
+  if (lengthCm != null && widthCm != null && heightCm != null) {
+    halfKg = Math.max(halfKg, (lengthCm * widthCm * heightCm) / (VOLUMETRIC_DIVISOR / 2));
+  }
+  return Math.ceil(halfKg) / 2;
+}
+
+export function shippingRate(weightOrShipment, zone) {
+  const weightKg =
+    typeof weightOrShipment === 'object' && weightOrShipment !== null
+      ? chargeableWeightKg(weightOrShipment)
+      : weightOrShipment;
   const table = RATES[zone];
   if (!table) {
