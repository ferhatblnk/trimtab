@@ -12,3 +12,28 @@ test('rejects unknown zones and bad weights', () => {
   assert.throws(() => shippingRate(1, 'XX'), /Unknown zone/);
   assert.throws(() => shippingRate(0, ZONES.DOMESTIC), /Invalid weight/);
 });
+
+test('uses EUR as the Europe zone code', () => {
+  assert.equal(ZONES.EUROPE, 'EUR');
+  assert.equal(shippingRate(1, 'EUR'), 1200);
+  assert.throws(() => shippingRate(1, 'EU'), /Unknown zone/);
+});
+
+test('computes the chargeable weight', () => {
+  // volumetric 40 × 30 × 20 / 5000 = 4.8 beats actual 0.8, rounds up to 5
+  assert.equal(chargeableWeightKg({ weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 }), 5);
+  // actual 1.2 beats volumetric 0.2, rounds up to 1.5
+  assert.equal(chargeableWeightKg({ weightKg: 1.2, lengthCm: 10, widthCm: 10, heightCm: 10 }), 1.5);
+  // exact multiples of 0.5 stay as they are
+  assert.equal(chargeableWeightKg({ weightKg: 2, lengthCm: 50, widthCm: 50, heightCm: 2 }), 2);
+  assert.equal(chargeableWeightKg({ weightKg: 0.1, lengthCm: 50, widthCm: 50, heightCm: 3 }), 1.5);
+  // a missing dimension falls back to the actual weight, still rounded up
+  assert.equal(chargeableWeightKg({ weightKg: 3.2, lengthCm: 100, widthCm: 100 }), 3.5);
+  assert.equal(chargeableWeightKg({ weightKg: 3 }), 3);
+});
+
+test('prices a shipment object by its chargeable weight', () => {
+  const shipment = { weightKg: 0.8, lengthCm: 40, widthCm: 30, heightCm: 20 };
+  assert.equal(shippingRate(shipment, ZONES.EUROPE), 2400);
+  assert.equal(shippingRate(0.8, ZONES.EUROPE), 1200);
+});
