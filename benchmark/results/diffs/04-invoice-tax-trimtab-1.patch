+// All arithmetic runs on BigInt so floating-point error can never change a cent.
+
+// A percentage with at most two decimals, as an integer number of hundredths of a percent.
+export function toBasisPoints(percent, name) {
+  if (typeof percent !== 'number' || !(percent >= 0 && percent <= 100)) {
+    throw new Error(`Invalid ${name}: ${percent}`);
+  }
+  const bp = Math.round(percent * 100);
+  if (Math.abs(percent * 100 - bp) > 1e-6) {
+    throw new Error(`Invalid ${name}: ${percent}`);
+  }
+  return BigInt(bp);
+}
+
+// numerator / denominator rounded half to even, symmetric around zero. denominator > 0.
+export function divRoundHalfEven(numerator, denominator) {
+  const negative = numerator < 0n;
+  const abs = negative ? -numerator : numerator;
+  let quotient = abs / denominator;
+  const twiceRemainder = (abs % denominator) * 2n;
+  if (twiceRemainder > denominator || (twiceRemainder === denominator && quotient % 2n === 1n)) {
+    quotient += 1n;
+  }
+  return negative ? -quotient : quotient;
+}
+
+// Split total across weights (all >= 0, summing to weightSum > 0) with the largest-remainder method.
+export function allocate(total, weights, weightSum) {
+  const shares = weights.map((weight) => (total * weight) / weightSum);
+  let leftover = total - shares.reduce((sum, share) => sum + share, 0n);
+  const order = weights
+    .map((weight, index) => ({ index, remainder: (total * weight) % weightSum }))
+    .sort((a, b) => (a.remainder === b.remainder ? a.index - b.index : a.remainder > b.remainder ? -1 : 1));
+  for (const { index } of order) {
+    if (leftover === 0n) {
+      break;
+    }
+    shares[index] += 1n;
+    leftover -= 1n;
+  }
+  return shares;
+}
+
+function toSafeNumber(value) {
+  const number = Number(value);
+  if (!Number.isSafeInteger(number)) {
+    throw new Error(`Amount out of range: ${value}`);
+  }
+  return number;
+}
+
+export function computeInvoice(lines, { taxRatePercent, discountPercent = 0 }) {
+  const taxBp = toBasisPoints(taxRatePercent, 'taxRatePercent');
+  const discountBp = toBasisPoints(discountPercent, 'discountPercent');
+
+  const nets = lines.map(({ quantity, unitCents }) => {
+    if (!Number.isInteger(quantity) || !Number.isInteger(unitCents)) {
+      throw new Error(`Invalid line: ${quantity} x ${unitCents}`);
+    }
+    return BigInt(quantity) * BigInt(unitCents);
+  });
+
+  const weights = nets.map((net) => (net > 0n ? net : 0n));
+  const positiveSum = weights.reduce((sum, weight) => sum + weight, 0n);
+  const invoiceDiscount = divRoundHalfEven(positiveSum * discountBp, 10000n);
+  const discounts = positiveSum > 0n ? allocate(invoiceDiscount, weights, positiveSum) : nets.map(() => 0n);
+
+  const totals = { netCents: 0n, discountCents: 0n, taxCents: 0n, grossCents: 0n };
+  const resultLines = nets.map((net, i) => {
+    const taxable = net - discounts[i];
+    const tax = divRoundHalfEven(taxable * taxBp, 10000n);
+    const line = { netCents: net, discountCents: discounts[i], taxCents: tax, grossCents: taxable + tax };
+    for (const key of Object.keys(totals)) {
+      totals[key] += line[key];
+    }
+    return Object.fromEntries(Object.entries(line).map(([key, value]) => [key, toSafeNumber(value)]));
+  });
+
+  return {
+    lines: resultLines,
+    netCents: toSafeNumber(totals.netCents),
+    discountCents: toSafeNumber(totals.discountCents),
+    taxCents: toSafeNumber(totals.taxCents),
+    grossCents: toSafeNumber(totals.grossCents),
+  };
+}
