+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { computeInvoice } from '../src/tax.js';
+
+test('computes an invoice with discount, tax and gross', () => {
+  const invoice = computeInvoice(
+    [
+      { quantity: 3, unitCents: 333 },
+      { quantity: 1, unitCents: 1 },
+    ],
+    { taxRatePercent: 20, discountPercent: 10 },
+  );
+  assert.deepEqual(invoice, {
+    lines: [
+      { netCents: 999, discountCents: 100, taxCents: 180, grossCents: 1079 },
+      { netCents: 1, discountCents: 0, taxCents: 0, grossCents: 1 },
+    ],
+    netCents: 1000,
+    discountCents: 100,
+    taxCents: 180,
+    grossCents: 1080,
+  });
+});
+
+test('rounds the invoice discount half to even and breaks ties toward earlier lines', () => {
+  const line = { quantity: 1, unitCents: 100 };
+  const invoice = computeInvoice([line, line, line], { taxRatePercent: 0, discountPercent: 0.5 });
+  assert.equal(invoice.discountCents, 2);
+  assert.deepEqual(invoice.lines.map((l) => l.discountCents), [1, 1, 0]);
+});
+
+test('gives credit lines no discount and rounds their tax symmetrically', () => {
+  const invoice = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1000 },
+      { quantity: -1, unitCents: 270 },
+    ],
+    { taxRatePercent: 5, discountPercent: 10 },
+  );
+  assert.deepEqual(invoice.lines[1], { netCents: -270, discountCents: 0, taxCents: -14, grossCents: -284 });
+  assert.deepEqual(invoice.lines[0], { netCents: 1000, discountCents: 100, taxCents: 45, grossCents: 945 });
+  assert.equal(invoice.grossCents, 661);
+});
+
+test('rounds tax half to even without floating-point drift', () => {
+  const tax = (unitCents, taxRatePercent) =>
+    computeInvoice([{ quantity: 1, unitCents }], { taxRatePercent }).taxCents;
+  assert.equal(tax(10, 5), 0);
+  assert.equal(tax(30, 5), 2);
+  assert.equal(tax(1000, 0.35), 4);
+  assert.equal(tax(1000, 1.15), 12);
+  assert.equal(tax(3000, 1.15), 34);
+  assert.equal(tax(200, 8.25), 16);
+  assert.equal(tax(600, 8.25), 50);
+});
+
+test('line discounts always add up to the invoice discount', () => {
+  const lines = [7, 13, 1, 29, 3].map((unitCents) => ({ quantity: 1, unitCents }));
+  const invoice = computeInvoice(lines, { taxRatePercent: 12.5, discountPercent: 33.33 });
+  assert.equal(invoice.discountCents, 18);
+  assert.equal(invoice.lines.reduce((sum, l) => sum + l.discountCents, 0), 18);
+});
+
+test('handles an empty invoice and an invoice with only credit lines', () => {
+  assert.deepEqual(computeInvoice([], { taxRatePercent: 20 }), {
+    lines: [],
+    netCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    grossCents: 0,
+  });
+  const credit = computeInvoice([{ quantity: -2, unitCents: 500 }], { taxRatePercent: 20, discountPercent: 50 });
+  assert.equal(credit.discountCents, 0);
+  assert.equal(credit.grossCents, -1200);
+});
+
+test('rejects invalid percentages', () => {
+  assert.throws(() => computeInvoice([], { taxRatePercent: 101 }));
+  assert.throws(() => computeInvoice([], { taxRatePercent: 8.255 }));
+  assert.throws(() => computeInvoice([], { taxRatePercent: 20, discountPercent: -1 }));
+});
