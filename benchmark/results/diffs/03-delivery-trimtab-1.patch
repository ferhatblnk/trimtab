diff --git a/src/delivery.js b/src/delivery.js
index 3a6f1de..5d25dd0 100644
--- a/src/delivery.js
+++ b/src/delivery.js
@@ -1,4 +1,11 @@
 const CUTOFF_HOUR = 15;
+const ISTANBUL_OFFSET_MS = 3 * 60 * 60 * 1000;
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+function isBusinessDay(date) {
+  const day = date.getUTCDay();
+  return day !== 0 && day !== 6;
+}
 
 /**
  * Expected delivery date of an order, as YYYY-MM-DD in Istanbul time (Europe/Istanbul, UTC+3 all year).
@@ -9,14 +16,21 @@ const CUTOFF_HOUR = 15;
  * - Business days are Monday to Friday.
  */
 export function estimateDelivery(orderedAt, transitDays) {
-  const date = new Date(orderedAt);
-  if (date.getHours() >= CUTOFF_HOUR) {
-    date.setDate(date.getDate() + 1);
+  // Shift into Istanbul wall-clock time and read it with UTC getters only,
+  // so the result does not depend on the server's time zone.
+  const local = new Date(new Date(orderedAt).getTime() + ISTANBUL_OFFSET_MS);
+  const date = new Date(Date.UTC(local.getUTCFullYear(), local.getUTCMonth(), local.getUTCDate()));
+
+  if (!isBusinessDay(date) || local.getUTCHours() >= CUTOFF_HOUR) {
+    do {
+      date.setTime(date.getTime() + DAY_MS);
+    } while (!isBusinessDay(date));
   }
+
   let remaining = transitDays;
   while (remaining > 0) {
-    date.setDate(date.getDate() + 1);
-    if (date.getDay() !== 0 && date.getDay() !== 6) {
+    date.setTime(date.getTime() + DAY_MS);
+    if (isBusinessDay(date)) {
       remaining--;
     }
   }
diff --git a/test/delivery.test.js b/test/delivery.test.js
index da49612..d2e2f72 100644
--- a/test/delivery.test.js
+++ b/test/delivery.test.js
@@ -5,3 +5,30 @@ import { estimateDelivery } from '../src/delivery.js';
 test('ships a weekday morning order the same day', () => {
   assert.equal(estimateDelivery('2026-09-15T10:00:00+03:00', 2), '2026-09-17');
 });
+
+test('ships a weekday order at or after the cutoff the next business day', () => {
+  assert.equal(estimateDelivery('2026-09-15T15:00:00+03:00', 2), '2026-09-18');
+});
+
+test('ships a Friday evening order on Monday', () => {
+  assert.equal(estimateDelivery('2026-09-18T18:00:00+03:00', 1), '2026-09-22');
+  assert.equal(estimateDelivery('2026-09-18T18:00:00+03:00', 0), '2026-09-21');
+});
+
+test('ships weekend orders on Monday', () => {
+  assert.equal(estimateDelivery('2026-09-19T09:00:00+03:00', 1), '2026-09-22');
+  assert.equal(estimateDelivery('2026-09-20T09:00:00+03:00', 2), '2026-09-23');
+});
+
+test('uses the Istanbul calendar day for orders just after midnight', () => {
+  // 00:30 Tuesday in Istanbul is still Monday in UTC.
+  assert.equal(estimateDelivery('2026-09-14T21:30:00Z', 1), '2026-09-16');
+  // 00:30 Saturday in Istanbul is still Friday in UTC.
+  assert.equal(estimateDelivery('2026-09-18T21:30:00Z', 1), '2026-09-22');
+});
+
+test('applies the cutoff in Istanbul time for UTC timestamps', () => {
+  // 11:59 UTC is 14:59 in Istanbul; 12:00 UTC is 15:00.
+  assert.equal(estimateDelivery('2026-09-15T11:59:00Z', 1), '2026-09-16');
+  assert.equal(estimateDelivery('2026-09-15T12:00:00Z', 1), '2026-09-17');
+});
