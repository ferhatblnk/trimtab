@@ -0,0 +1,99 @@
+// All arithmetic is done in BigInt so floating-point error can never change a cent.
+
+// A percentage with at most two decimals, as an integer number of hundredths of a percent.
+function toBasisPoints(percent, name) {
+  if (typeof percent !== 'number' || !(percent >= 0 && percent <= 100)) {
+    throw new Error(`Invalid ${name}: ${percent}`);
+  }
+  const basisPoints = Math.round(percent * 100);
+  if (Math.abs(percent * 100 - basisPoints) > 1e-6) {
+    throw new Error(`Invalid ${name}: ${percent} has more than two decimals`);
+  }
+  return BigInt(basisPoints);
+}
+
+function toBigInt(value, name) {
+  if (!Number.isSafeInteger(value)) {
+    throw new Error(`Invalid ${name}: ${value}`);
+  }
+  return BigInt(value);
+}
+
+function toNumber(value) {
+  const number = Number(value);
+  if (!Number.isSafeInteger(number)) {
+    throw new Error(`Amount out of range: ${value}`);
+  }
+  return number;
+}
+
+// numerator / denominator rounded half-to-even, symmetric for negatives. denominator > 0.
+export function divRoundHalfEven(numerator, denominator) {
+  const negative = numerator < 0n;
+  const abs = negative ? -numerator : numerator;
+  let quotient = abs / denominator;
+  const twiceRemainder = (abs % denominator) * 2n;
+  if (twiceRemainder > denominator || (twiceRemainder === denominator && quotient % 2n === 1n)) {
+    quotient += 1n;
+  }
+  return negative ? -quotient : quotient;
+}
+
+// Splits `total` across `weights` (all > 0) in proportion, with the largest-remainder method.
+export function allocateLargestRemainder(total, weights) {
+  const sum = weights.reduce((acc, weight) => acc + weight, 0n);
+  if (sum === 0n) {
+    return weights.map(() => 0n);
+  }
+  const shares = weights.map((weight) => (total * weight) / sum);
+  const remainders = weights.map((weight, index) => ({ index, remainder: (total * weight) % sum }));
+  let left = total - shares.reduce((acc, share) => acc + share, 0n);
+  remainders.sort((a, b) => (a.remainder === b.remainder ? a.index - b.index : a.remainder > b.remainder ? -1 : 1));
+  for (const { index } of remainders) {
+    if (left === 0n) {
+      break;
+    }
+    shares[index] += 1n;
+    left -= 1n;
+  }
+  return shares;
+}
+
+export function computeInvoice(lines, { taxRatePercent, discountPercent = 0 } = {}) {
+  const taxBp = toBasisPoints(taxRatePercent, 'taxRatePercent');
+  const discountBp = toBasisPoints(discountPercent, 'discountPercent');
+
+  const nets = lines.map((line) => toBigInt(line.quantity, 'quantity') * toBigInt(line.unitCents, 'unitCents'));
+  const positive = nets.map((net, index) => ({ net, index })).filter(({ net }) => net > 0n);
+  const positiveSum = positive.reduce((acc, { net }) => acc + net, 0n);
+
+  const invoiceDiscount = divRoundHalfEven(positiveSum * discountBp, 10000n);
+  const discounts = nets.map(() => 0n);
+  const allocated = allocateLargestRemainder(
+    invoiceDiscount,
+    positive.map(({ net }) => net),
+  );
+  positive.forEach(({ index }, i) => {
+    discounts[index] = allocated[i];
+  });
+
+  const result = nets.map((net, index) => {
+    const taxable = net - discounts[index];
+    const tax = divRoundHalfEven(taxable * taxBp, 10000n);
+    return { net, discount: discounts[index], tax, gross: taxable + tax };
+  });
+
+  const sum = (key) => toNumber(result.reduce((acc, line) => acc + line[key], 0n));
+  return {
+    lines: result.map((line) => ({
+      netCents: toNumber(line.net),
+      discountCents: toNumber(line.discount),
+      taxCents: toNumber(line.tax),
+      grossCents: toNumber(line.gross),
+    })),
+    netCents: sum('net'),
+    discountCents: sum('discount'),
+    taxCents: sum('tax'),
+    grossCents: sum('gross'),
+  };
+}
diff --git a/test/tax.test.js b/test/tax.test.js
