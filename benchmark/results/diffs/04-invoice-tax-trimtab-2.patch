@@ -0,0 +1,108 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { computeInvoice } from '../src/tax.js';
+
+test('computes lines and totals with a credit line', () => {
+  const result = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1000 },
+      { quantity: 1, unitCents: 2000 },
+      { quantity: -1, unitCents: 500 },
+    ],
+    { taxRatePercent: 20, discountPercent: 10 },
+  );
+  assert.deepEqual(result, {
+    lines: [
+      { netCents: 1000, discountCents: 100, taxCents: 180, grossCents: 1080 },
+      { netCents: 2000, discountCents: 200, taxCents: 360, grossCents: 2160 },
+      { netCents: -500, discountCents: 0, taxCents: -100, grossCents: -600 },
+    ],
+    netCents: 2500,
+    discountCents: 300,
+    taxCents: 440,
+    grossCents: 2640,
+  });
+});
+
+test('discount defaults to zero', () => {
+  const result = computeInvoice([{ quantity: 3, unitCents: 250 }], { taxRatePercent: 8.25 });
+  assert.deepEqual(result.lines, [{ netCents: 750, discountCents: 0, taxCents: 62, grossCents: 812 }]);
+});
+
+test('rounds the invoice discount half to even', () => {
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 25 }], { taxRatePercent: 0, discountPercent: 10 }).discountCents, 2);
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 35 }], { taxRatePercent: 0, discountPercent: 10 }).discountCents, 4);
+});
+
+test('splits the discount with largest remainder, ties to the earlier line', () => {
+  const result = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1 },
+      { quantity: -5, unitCents: 1 },
+      { quantity: 1, unitCents: 1 },
+      { quantity: 1, unitCents: 1 },
+    ],
+    { taxRatePercent: 0, discountPercent: 66.67 },
+  );
+  assert.equal(result.discountCents, 2);
+  assert.deepEqual(result.lines.map((line) => line.discountCents), [1, 0, 1, 0]);
+
+  const uneven = computeInvoice(
+    [
+      { quantity: 1, unitCents: 100 },
+      { quantity: 1, unitCents: 200 },
+      { quantity: 1, unitCents: 400 },
+    ],
+    { taxRatePercent: 0, discountPercent: 1 },
+  );
+  // 7 cents: exact shares 1, 2, 4.
+  assert.deepEqual(uneven.lines.map((line) => line.discountCents), [1, 2, 4]);
+
+  const remainders = computeInvoice(
+    [
+      { quantity: 1, unitCents: 1 },
+      { quantity: 1, unitCents: 2 },
+      { quantity: 1, unitCents: 4 },
+    ],
+    { taxRatePercent: 0, discountPercent: 50 },
+  );
+  // 3.5 rounds to 4 cents; exact shares 4/7, 8/7, 16/7 floor to 0, 1, 2; remainders 4, 1, 2.
+  assert.deepEqual(remainders.lines.map((line) => line.discountCents), [1, 1, 2]);
+});
+
+test('rounds tax half to even, symmetric for negatives', () => {
+  const tax = (unitCents, taxRatePercent) =>
+    computeInvoice([{ quantity: 1, unitCents }], { taxRatePercent }).taxCents;
+  assert.equal(tax(135, 10), 14);
+  assert.equal(tax(125, 10), 12);
+  assert.equal(tax(-135, 10), -14);
+  assert.equal(tax(-125, 10), -12);
+  assert.equal(tax(200, 8.25), 16);
+});
+
+test('floating-point error never changes a cent', () => {
+  // 1000 * 1.15 / 100 is 11.499999999999998 in floating point; exactly it is 11.5, which rounds to 12.
+  assert.equal(computeInvoice([{ quantity: 1, unitCents: 1000 }], { taxRatePercent: 1.15 }).taxCents, 12);
+  assert.equal(
+    computeInvoice([{ quantity: 1, unitCents: 1000 }], { taxRatePercent: 0, discountPercent: 1.15 }).discountCents,
+    12,
+  );
+});
+
+test('handles an empty invoice and an all-credit invoice', () => {
+  assert.deepEqual(computeInvoice([], { taxRatePercent: 20, discountPercent: 10 }), {
+    lines: [],
+    netCents: 0,
+    discountCents: 0,
+    taxCents: 0,
+    grossCents: 0,
+  });
+  const credit = computeInvoice([{ quantity: -2, unitCents: 500 }], { taxRatePercent: 20, discountPercent: 10 });
+  assert.deepEqual(credit.lines, [{ netCents: -1000, discountCents: 0, taxCents: -200, grossCents: -1200 }]);
+});
+
+test('rejects invalid percentages', () => {
+  assert.throws(() => computeInvoice([], { taxRatePercent: 101 }));
+  assert.throws(() => computeInvoice([], { taxRatePercent: 20, discountPercent: 1.234 }));
+  assert.throws(() => computeInvoice([], {}));
+});
